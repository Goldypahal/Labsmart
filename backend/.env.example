# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PORT=5001
NODE_ENV=development
DATABASE_URL="postgresql://labsmart_dev:CHANGE_ME@localhost:5432/labsmart_dev?schema=public"
# Optional. Leave empty to use the in-memory fallback in development.
REDIS_URL=""
# Required in production: at least 32 random characters each, and different from each other.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"
S3_ENDPOINT=""
S3_BUCKET="labsmart-reports"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
